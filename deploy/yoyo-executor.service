[Unit]
Description=Yoyo isolated project executor
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=dsh-life
RuntimeDirectory=yoyo-executor
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/opt/dsh-life-runtime/node/bin/node /opt/dsh-life-assistant/deploy/executor.mjs
Restart=on-failure
RestartSec=5
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yoyo-executor /run/yoyo-executor /run/docker.sock
NoNewPrivileges=true
MemoryMax=96M
TasksMax=32

[Install]
WantedBy=multi-user.target
