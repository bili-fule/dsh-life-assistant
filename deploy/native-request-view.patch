+import { describe, expect, it } from 'vitest'
+import { createUserMessage,createAssistantMessage,createToolResultMessage,ToolCallId } from '@deepseek-ai/dsh-llm'
+import { Session, SessionId, SessionSeq, foldSurface, deriveEventMessage } from '../src/index.ts'
+import type { SessionEventMap, SessionMessageProjection } from '../src/index.ts'
+import { Context } from '@deepseek-ai/cordis'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import TokenMeter from '@deepseek-ai/dsh-token-meter'
+import { selectCompactableRange } from '../../../compaction/compaction-basic/src/region.ts'
+import ToolResultPruner from '@deepseek-ai/dsh-compaction-tool-result-pruner'
+
+function input(session: Session, text: string) {
+  return session.append('user/message', createUserMessage({ content: [{type: 'text', text}], source: {kind: 'user'} }), {surfaceOp: 'append'})
+}
+function view(session: Session, seqs: number[]) {
+  return session.append('request/view', {viewId: 'view' as SessionEventMap['request/view']['viewId'], visibleSeqs: seqs.map(SessionSeq), scopes: ['public'], authorizationVersion: null})
+}
+function text(session: Session) {return JSON.stringify(session.deriveMessages())}
+
+describe('logged activity request views', () => {
+  it('does not choose hidden private work for another activity compaction', async () => {
+    const ctx=new Context();new SessionProjectionRegistry(ctx);const meter=new TokenMeter(ctx,{})
+    try{
+      const s=Session.create(SessionId('private-work-retained'))
+      const secret=input(s,'PRIVATE_WORK_CANARY')
+      const publicOld=input(s,'public old '.repeat(1000))
+      input(s,'other hidden work')
+      const publicLarge=input(s,'public large '.repeat(3000))
+      const tail=input(s,'tail '.repeat(200))
+      view(s,[publicOld.seq,publicLarge.seq,tail.seq])
+      const range=selectCompactableRange(s,meter.measure(s),1)
+      expect(range).toEqual({start:publicLarge.seq,end:publicLarge.seq})
+      s.append('user/message',createUserMessage({content:[{type:'text',text:'public summary'}],source:{kind:'user'}}),{surfaceOp:{op:'replace',startSeq:publicLarge.seq,endSeq:publicLarge.seq},sourceEventSeqs:[publicLarge.seq]})
+      view(s,[secret.seq])
+      expect(text(s)).toContain('PRIVATE_WORK_CANARY')
+    }finally{await ctx.fiber.dispose()}
+  })
+  it('skips hidden tool results during model-free pruning', async () => {
+    const ctx=new Context();new SessionProjectionRegistry(ctx);new TokenMeter(ctx,{})
+    const pruner=new ToolResultPruner(ctx,{thresholdChars:50,headChars:4,tailChars:3})
+    try{
+      const s=Session.create(SessionId('private-tool-result'))
+      const secret=s.append('tool/result',{turn:1,step:1,message:createToolResultMessage({callId:ToolCallId('private'),content:[{type:'text',text:'PRIVATE_TOOL_RESULT'.repeat(100)}],isError:false})},{surfaceOp:'append'})
+      view(s,[])
+      expect(()=>pruner.pruneSession(s)).not.toThrow()
+      view(s,[secret.seq]);expect(text(s)).toContain('PRIVATE_TOOL_RESULT'.repeat(100))
+    }finally{await ctx.fiber.dispose()}
+  })
+  it('uses the same visibility for native context accounting', async () => {
+    const ctx = new Context()
+    new SessionProjectionRegistry(ctx)
+    const meter = new TokenMeter(ctx,{})
+    try {
+      const s = Session.create(SessionId('metered-view'))
+      const privateNode = input(s,'private '.repeat(10000))
+      const publicNode = input(s,'public')
+      const before = meter.measure(s).totalTokens
+      view(s,[publicNode.seq])
+      const after = meter.measure(s)
+      expect(after.totalTokens).toBeLessThan(before)
+      expect(after.surfaceTokens).toBe(meter.estimateMessage(s.deriveMessages()[0]!))
+      const breakdown=ctx.sessionProjections.snapshot(s).values.contextBreakdown
+      expect(breakdown?.messageTokens).toBe(after.surfaceTokens)
+      const checkpoint=JSON.parse(JSON.stringify(ctx.sessionProjections.checkpoint(s)))
+      expect(ctx.sessionProjections.viewCheckpoint(checkpoint).contextBreakdown).toEqual(breakdown)
+      view(s,[privateNode.seq,publicNode.seq])
+      expect(meter.measure(s).totalTokens).toBe(before)
+    } finally { await ctx.fiber.dispose() }
+  })
+  it('keeps a tool invocation and its response together', () => {
+    const s = Session.create(SessionId('tool-pair'))
+    const id = ToolCallId('call')
+    const call = s.append('assistant/message', {turn:1,step:1,stream:[],message:createAssistantMessage({source:{provider:'test',model:'test'},content:[{type:'tool-call',id,name:'read',arguments:'{}'}]})}, {surfaceOp:'append'})
+    const result = s.append('tool/result', {turn:1,step:1,message:createToolResultMessage({callId:id,isError:false,content:[{type:'text',text:'private result'}]})}, {surfaceOp:'append'})
+    expect(() => view(s,[call.seq])).toThrow(/paired/)
+    expect(() => view(s,[result.seq])).toThrow(/paired/)
+    view(s,[])
+    expect(s.deriveMessages()).toEqual([])
+    view(s,[call.seq,result.seq])
+    expect(s.deriveMessages()).toHaveLength(2)
+  })
+  it('hides private history and restores it within the same session', () => {
+    const s = Session.create(SessionId('one-mind'))
+    const secret = input(s, 'PRIVATE_CANARY_4bf871')
+    const publicText = input(s, 'public information')
+    const original = s.deriveMessages()[0]
+    view(s, [publicText.seq])
+    expect(text(s)).not.toContain('PRIVATE_CANARY_4bf871')
+    expect(text(s)).toContain('public information')
+    input(s, 'new public activity')
+    expect(text(s)).toContain('new public activity')
+    view(s, [secret.seq])
+    expect(text(s)).toContain('PRIVATE_CANARY_4bf871')
+    expect(text(s)).not.toContain('public information')
+    expect(s.deriveMessages()[0]).toBe(original)
+    expect(s.id).toBe('one-mind')
+  })
+  it('replays the selection after restart and through detached folds', () => {
+    const s = Session.create(SessionId('resume'))
+    input(s, 'private data')
+    const allowed = input(s, 'visible')
+    view(s, [allowed.seq])
+    const events = s.snapshotEvents()
+    const restored = Session.create(s.id, events)
+    expect(restored.deriveMessages()).toEqual(s.deriveMessages())
+    const folded = foldSurface(events)
+    const messages = folded.nodes.map(seq => deriveEventMessage(events[seq]!, folded.projectedMessages)).filter(Boolean)
+    expect(messages).toEqual(s.deriveMessages())
+  })
+  it('rejects duplicate and nonexistent selected nodes before commit', () => {
+    const s = Session.create(SessionId('invalid'))
+    const allowed = input(s, 'visible')
+    const before = s.seq
+    expect(() => view(s, [999])).toThrow(/current surface/)
+    expect(() => view(s, [allowed.seq, allowed.seq])).toThrow(/unique/)
+    expect(s.seq).toBe(before)
+    expect(text(s)).toContain('visible')
+    view(s, [])
+    expect(s.deriveMessages()).toEqual([])
+  })
+  it('retains independent content projection changes while a node is hidden', () => {
+    const projection: SessionMessageProjection<'image/offload'> = {
+      type: 'image/offload',
+      project(event, context) {
+        const seq = event.data.targets[0]!.seq
+        const source = context.events[seq - context.baseSeq]!
+        const original = deriveEventMessage(source)!
+        return new Map([[seq, {...original, content: [{type: 'text', text: 'offloaded safe representation'}]}]])
+      },
+    }
+    const s = Session.create(SessionId('with-offload'), undefined, undefined, undefined, [projection])
+    const privateNode = input(s, 'private image reference')
+    view(s, [])
+    s.append('image/offload', {targets: [{seq: privateNode.seq, imageIndexes: [0]}]})
+    expect(text(s)).not.toContain('offloaded safe representation')
+    view(s, [privateNode.seq])
+    expect(text(s)).toContain('offloaded safe representation')
+    expect(text(s)).not.toContain('private image reference')
+  })
+})
